# ── WizCodes Case Study Agent — environment ──
# Copy to `.env` for local runs. In production these are the workflow's `env:`
# block in .github/workflows/publish.yml. NEVER commit the real .env.

# ── Claude-compatible proxy (LLMsRelay — was ClaudeStore until 2026-08-16) ──
# Identical to the blog agent — same proxy, same models. The CLI User-Agent its
# Cloudflare requires is handled in core/llm/client.py, not here.
ANTHROPIC_BASE_URL=https://api.llmsrelay.com
ANTHROPIC_API_KEY=sk-cs2-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4.6
ANTHROPIC_SMALL_FAST_MODEL=claude-haiku-4.5
ANTHROPIC_STRATEGY_MODEL=claude-opus-4-8

# ── GitHub publishing ──
# Fine-grained PAT scoped to ONLY the wizcodes site repo, with
# Contents: Read and write AND Pull requests: Read and write.
# (The blog agent's token needs only Contents — this one opens PRs.)
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx
GITHUB_REPO=dkcodes121617/wizcodes_main_website
GITHUB_BRANCH=main
GIT_AUTHOR_NAME=WizCodes Case Study Bot
GIT_AUTHOR_EMAIL=business@wizcodes.site

# ── Cadence ──
# NOTE: no inline "# comment" after a value — python-dotenv keeps it as part of
# the value. Keep comments on their own lines.
STUDIES_PER_MONTH=1

# ── Safety ──
# OPEN_PR=1 opens a pull request instead of pushing to main. Set to 0 only if you
# genuinely want unattended publishing of pages that name real clients.
OPEN_PR=1
# A brief containing [NEEDS REVIEW] blocks the writer. Turning this off lets the
# agent invent the very things the marker exists to flag.
REQUIRE_CLEAN_BRIEF=1

# ── Behaviour ──
# DRY_RUN=1 → write to output/ and never touch git (safe for local testing).
DRY_RUN=1
LOG_LEVEL=INFO
